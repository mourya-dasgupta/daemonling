{
  "name": "@daemonling/store",
  "version": "0.1.0",
  "description": "Event log + snapshot persistence for Daemonling (Node files and browser IndexedDB).",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "daemonling-source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "daemonling-source": "./src/node.ts",
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@daemonling/core": "workspace:*"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.7"
  }
}
